# ==============================================================================
# OPD Saathi — Environment Variables Template (.env.example)
# Copy this file to .env for local development: Copy-Item .env.example .env
# NEVER commit .env or real credentials to Git.
# ==============================================================================

NODE_ENV=development
PORT=3000
DEMO_MODE=true

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection
# Copy the exact Session Pooler (IPv4) connection string from:
# Supabase Dashboard -> Connect -> Session Pooler
# ------------------------------------------------------------------------------
DATABASE_URL=

# TLS Mode:
# - "verify-full" (required in production; verifies server cert against Supabase Root CA)
# - "disable" (allowed ONLY in local development/test against a local non-TLS Postgres)
DATABASE_SSL_MODE=verify-full

# Supabase Root CA Certificate (required when DATABASE_SSL_MODE=verify-full or NODE_ENV=production)
# Provide EITHER inline/base64 PEM in DATABASE_CA_CERT OR a local file path in DATABASE_CA_CERT_PATH
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=

# ------------------------------------------------------------------------------
# Security & Authentication Secrets (Must be distinct 64-character hex strings)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
SESSION_SECRET=replace-with-64-char-hex-session-secret-for-local-dev-only-0000
TICKET_TOKEN_SECRET=replace-with-separate-64-char-hex-ticket-secret-local-dev-1111
TICKET_TOKEN_SECRET_PREVIOUS=

# Bcrypt hash for the synthetic demo staff PIN (e.g. PIN "1234" -> $2a$10$...)
# Generate via: node -e "require('bcryptjs').hash('1234', 10).then(console.log)"
STAFF_DEMO_PIN_HASH=
